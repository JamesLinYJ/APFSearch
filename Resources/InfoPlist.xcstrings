    },
    "NSDocumentsFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引文稿中的文件名称与属性，供文件搜索。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index document filenames and properties for local search."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引文件中的檔案名稱與屬性，以供檔案搜尋。"
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引桌面文件，供文件搜索。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index desktop files for local search."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引桌面檔案，以供檔案搜尋。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引下载文件，供文件搜索。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index downloaded files for local search."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引下載的檔案，以供檔案搜尋。"
          }
        }
      }
    },
    "NSRemovableVolumesUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引你选择的本地外置卷。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index the local external volumes you select."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引你選擇的本機外接卷宗。"
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch 贡献者。独立实现；与 voidtools 无关联。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch contributors. Independent implementation; not affiliated with voidtools."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch 貢獻者。獨立實作；與 voidtools 無關聯。"
          }
        }
      }
    }
  }
