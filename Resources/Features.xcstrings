    "files.history_page_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the latest %@ of %@ operations. Unfinished intents require review; they are not automatically retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示最近 %@ 项，共 %@ 项。未完成的操作计划需要检查，不会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示最近 %@ 個操作，共 %@ 個。未完成的操作計畫需要檢查，不會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全%2$@件中、最新の%1$@件の操作を表示しています。未完了の操作予定は確認が必要で、自動的には再実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 %2$@개 중 최근 %1$@개 작업을 표시합니다. 완료되지 않은 작업 의도는 검토가 필요하며 자동으로 재시도되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны последние %1$@ из %2$@ операций. Незавершённые намерения требуют проверки и не повторяются автоматически."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran las últimas %1$@ de %2$@ operaciones. Las intenciones sin completar requieren revisión y no se reintentan automáticamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São apresentadas as últimas %1$@ de %2$@ operações. As intenções não concluídas requerem revisão e não são repetidas automaticamente."
          }
        }
      }
    },
