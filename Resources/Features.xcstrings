{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "directory.logical_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizes sum indexed directory entries, not physical storage or reclaimable space. Incomplete coverage is shown as unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小按已索引的目录项汇总，不代表实际占用或可回收空间。覆盖不完整时显示未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大小依已索引的目錄項目加總，不代表實際占用或可回收空間。涵蓋不完整時顯示未知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズは索引内のディレクトリ項目の合計であり、物理的な使用容量や解放可能な容量ではありません。網羅状況が不完全な場合は不明と表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기는 색인에 포함된 디렉터리 항목의 합계이며 실제 저장 공간이나 확보 가능한 공간을 뜻하지 않습니다. 포함 현황이 불완전하면 알 수 없음으로 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размеры — сумма записей каталогов в индексе, а не занятое или освобождаемое место. При неполном охвате размер показан как неизвестный."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños suman las entradas de directorio indexadas, no el almacenamiento físico ni el espacio recuperable. Si la cobertura es incompleta, se muestran como desconocidos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tamanhos somam as entradas de diretório indexadas, não o armazenamento físico nem o espaço recuperável. A cobertura incompleta é indicada como desconhecida."
          }
        }
      }
    },
    "directory.show_sizes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Recursive Folder Sizes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示文件夹递归大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示資料夾遞迴大小"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブフォルダを含むフォルダサイズを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 폴더를 포함한 크기 표시"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать размеры папок с подпапками"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar tamaños de carpetas con subcarpetas"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar tamanhos de pastas com subpastas"
          }
        }
      }
    },
    "directory.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown — incomplete coverage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知 — 覆盖不完整"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知 — 涵蓋不完整"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明 — 網羅状況が不完全です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없음 — 포함 현황 불완전"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестно — неполный охват"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconocido — cobertura incompleta"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconhecido — cobertura incompleta"
          }
        }
      }
    },
