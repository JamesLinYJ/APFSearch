    "files.batch_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at most 100,000 entries per operation. Nothing was changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次操作最多选择 100,000 项。未更改任何文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次操作最多選取 100,000 個項目。未更改任何檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の操作で選択できるのは100,000項目までです。変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업당 최대 100,000개 항목을 선택할 수 있습니다. 변경된 내용은 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За одну операцию можно выбрать не более 100 000 записей. Ничего не изменено."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona como máximo 100.000 entradas por operación. No se ha cambiado nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione no máximo 100 000 entradas por operação. Nada foi alterado."
          }
        }
      }
    },
    "files.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many pending file operations, or the request identifier is already in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理的文件操作过多，或请求标识已在使用中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待處理的檔案操作過多，或要求識別碼已在使用中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中のファイル操作が多すぎるか、リクエスト識別子がすでに使用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 파일 작업이 너무 많거나 요청 식별자가 이미 사용 중입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много ожидающих операций, либо идентификатор запроса уже используется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas operaciones de archivos pendientes o el identificador de solicitud ya está en uso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem demasiadas operações de ficheiros pendentes ou o identificador do pedido já está em uso."
          }
        }
      }
    },
    "files.cancelling_batch": {
      "localizations": {
