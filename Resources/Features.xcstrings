    "files.performing_batch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying file operations (stop after current item)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在执行文件操作（停止将在当前项完成后生效）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在執行檔案操作（停止將在目前項目完成後生效）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル操作を適用中（現在の項目の処理後に停止できます）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 작업 적용 중(현재 항목 처리 후 중단 가능)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнение операций (остановка после текущего объекта)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicando operaciones de archivos (detener después del elemento actual)"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicar operações de ficheiros (parar após o item atual)"
          }
        }
      }
    },
    "files.preview_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncheck items to skip them. Edit a destination leaf name to resolve a conflict; Continue rechecks edited names before a second confirmation. Existing files will not be overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾选可跳过项目。编辑目标文件名可处理冲突；继续后会重新检查，并再次确认。不会覆盖已有文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消勾選可略過項目。編輯目標檔名可處理衝突；繼續後會重新檢查，並再次確認。不會覆寫現有檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップする項目のチェックを外してください。競合を解消するには移動先の末尾の名前を編集します。「続ける」で編集した名前を再確認し、2回目の確認を表示します。既存のファイルは上書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건너뛸 항목의 체크를 해제하십시오. 충돌을 해결하려면 대상의 마지막 이름을 수정하십시오. '계속'을 누르면 수정한 이름을 다시 검사하고 두 번째 확인을 표시합니다. 기존 파일은 덮어쓰지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимите флажки с пропускаемых объектов. Для устранения конфликта измените конечное имя назначения; «Продолжить» перепроверит имена перед повторным подтверждением. Существующие файлы не перезаписываются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarca los elementos que quieras omitir. Edita el nombre final del destino para resolver un conflicto; Continuar volverá a comprobar los nombres antes de una segunda confirmación. No se sobrescribirán archivos existentes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desmarque os itens a ignorar. Edite o nome final do destino para resolver um conflito; Continuar verifica novamente os nomes antes de uma segunda confirmação. Os ficheiros existentes não serão substituídos."
          }
        }
      }
    },
