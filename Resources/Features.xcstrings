    "files.invalid_conflict_policy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported conflict policy. Existing files are never overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此冲突策略。不会覆盖已有文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援此衝突策略。不會覆寫現有檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未対応の競合処理です。既存のファイルは上書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 충돌 처리 정책입니다. 기존 파일은 덮어쓰지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика конфликтов не поддерживается. Существующие файлы никогда не перезаписываются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La política de conflictos no es compatible. Nunca se sobrescriben archivos existentes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A política de conflitos não é suportada. Os ficheiros existentes nunca são substituídos."
          }
        }
      }
    },
    "files.invalid_journal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation journal is invalid or is not a regular file. No operation was started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作日志无效或不是普通文件。未开始执行操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作記錄無效或不是一般檔案。尚未開始執行操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作ログが無効か、通常のファイルではありません。操作は開始されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 저널이 잘못되었거나 일반 파일이 아닙니다. 작업을 시작하지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал операций недействителен или не является обычным файлом. Операция не начата."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario de operaciones no es válido o no es un archivo normal. No se inició ninguna operación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O diário de operações é inválido ou não é um ficheiro regular. Nenhuma operação foi iniciada."
          }
        }
      }
    },
