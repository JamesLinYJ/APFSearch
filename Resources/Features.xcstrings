    "update.too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response exceeds the signed or configured byte limit. The transfer was stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应超过签名或配置的大小限制。已停止传输。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應超過簽章或設定的大小限制。已停止傳輸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が署名済みまたは設定済みのバイト上限を超えたため、転送を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 서명되거나 설정된 바이트 한도를 초과하여 전송을 중단했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ превышает подписанный или настроенный лимит байтов. Передача остановлена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta supera el límite de bytes firmado o configurado. Se detuvo la transferencia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta excede o limite de bytes assinado ou configurado. A transferência foi interrompida."
          }
        }
      }
    },
