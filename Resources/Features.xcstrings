    "files.source_changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source identity or metadata changed after selection. Review the files and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择后源文件的身份或元数据发生变化。请检查文件后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取後來源檔案的身分或中繼資料已變更。請檢查檔案後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択後に操作元の識別情報またはメタデータが変わりました。ファイルを確認してやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 후 원본의 식별 정보나 메타데이터가 변경되었습니다. 파일을 검토한 뒤 다시 시도하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выбора изменились идентификатор или метаданные источника. Проверьте файлы и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad o los metadatos del origen cambiaron tras la selección. Revisa los archivos e inténtalo de nuevo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade ou os metadados da origem mudaram após a seleção. Reveja os ficheiros e tente novamente."
          }
        }
      }
    },
    "files.survivor_changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The duplicate group no longer has its verified retained file. No further cleanup was performed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复组中要保留的文件已无法验证。已停止后续清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複群組中要保留的檔案已無法驗證。已停止後續清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複グループに残すはずの検証済みファイルがなくなりました。これ以上の整理は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중복 그룹에서 보존하기로 한 검증된 파일이 더 이상 존재하지 않습니다. 추가 정리는 수행하지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе дубликатов больше нет проверенного сохраняемого файла. Дальнейшая очистка не выполнялась."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El grupo de duplicados ya no contiene el archivo verificado que debía conservarse. No se realizó más limpieza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O grupo de duplicados já não contém o ficheiro verificado que devia ser mantido. Não foi efetuada mais limpeza."
          }
        }
      }
    },
    "files.unchanged": {
      "localizations": {
