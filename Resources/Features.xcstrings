    "update.digest_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded installer does not match the signed size or SHA-256 digest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的安装包大小或 SHA-256 摘要与签名内容不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的安裝套件大小或 SHA-256 摘要與簽章內容不符。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたインストーラが署名済みのサイズまたはSHA-256ダイジェストと一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 설치 프로그램이 서명된 크기 또는 SHA-256 다이제스트와 일치하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер или SHA-256 загруженного установщика не совпадает с подписанными данными."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador descargado no coincide con el tamaño o el resumen SHA-256 firmado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador descarregado não corresponde ao tamanho ou ao resumo SHA-256 assinado."
          }
        }
      }
    },
    "update.disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates are not configured in this build. A trusted public key and HTTPS feed must be embedded before signing a release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建尚未配置更新。正式签名前需嵌入可信公钥和 HTTPS 更新源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此建置尚未設定更新。正式簽章前需嵌入可信公鑰及 HTTPS 更新來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドではアップデートが構成されていません。リリースの署名前に、信頼できる公開鍵とHTTPSフィードを組み込む必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 업데이트가 구성되지 않았습니다. 릴리스에 서명하기 전에 신뢰할 수 있는 공개 키와 HTTPS 피드를 포함해야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой сборке обновления не настроены. Перед подписью выпуска нужно встроить доверенный открытый ключ и HTTPS-канал."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones no están configuradas en esta compilación. Antes de firmar una versión, deben integrarse una clave pública de confianza y un canal HTTPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações não estão configuradas nesta compilação. Antes de assinar uma versão, é necessário incluir uma chave pública de confiança e um canal HTTPS."
          }
        }
      }
    },
