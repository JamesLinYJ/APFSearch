    "update.download_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download %@? The manifest signature, byte limit and SHA-256 digest are checked before opening Installer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 %@？打开安装器前将检查清单签名、大小限制和 SHA-256 摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載 %@？開啟安裝程式前將檢查清單簽章、大小限制及 SHA-256 摘要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をダウンロードしますか？インストーラを開く前に、マニフェストの署名、バイト上限、SHA-256ダイジェストを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 다운로드하시겠습니까? 설치 프로그램을 열기 전에 매니페스트 서명, 바이트 한도 및 SHA-256 다이제스트를 확인합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить %@? Перед открытием установщика проверяются подпись манифеста, лимит байтов и SHA-256."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descargar %@? Antes de abrir el instalador se comprueban la firma del manifiesto, el límite de bytes y el resumen SHA-256."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarregar %@? A assinatura do manifesto, o limite de bytes e o resumo SHA-256 são verificados antes de abrir o Instalador."
          }
        }
      }
    },
