{"sourceLanguage":"en","version":"1.0","strings":{
  "directory.logical_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Sizes sum indexed directory entries, not physical storage or reclaimable space. Incomplete coverage is shown as unknown."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"大小按已索引的目录项汇总，不代表实际占用或可回收空间。覆盖不完整时显示未知。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"大小依已索引的目錄項目加總，不代表實際占用或可回收空間。涵蓋不完整時顯示未知。"}}}},
  "directory.show_sizes":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show Recursive Folder Sizes"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示文件夹递归大小"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示資料夾遞迴大小"}}}},
  "directory.unknown":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unknown — incomplete coverage"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未知 — 覆盖不完整"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未知 — 涵蓋不完整"}}}},
  "duplicates.group":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Group"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"分组"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"群組"}}}},
  "duplicates.hardlink_alias":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Hard-link alias (review only)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"硬链接别名（仅供查看）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"硬連結別名（僅供檢視）"}}}},
  "duplicates.keep_one":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep at least one verified file in every group."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每组至少保留一个已验证的文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每組至少保留一個已驗證的檔案。"}}}},
  "duplicates.manage_selection":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Review Selected Copies…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查所选副本…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查所選副本…"}}}},
  "duplicates.partial_label":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Partial results"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果不完整"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結果不完整"}}}},
  "duplicates.relationship":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Relationship evidence"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"关系证据"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"關係證據"}}}},
  "duplicates.same_content":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Same content; storage unknown"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"内容相同；存储关系未知"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"內容相同；儲存關係未知"}}}},
  "duplicates.select_extras":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select Extra Copies"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择多余副本"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選取多餘副本"}}}},
  "duplicates.verified_clone":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verified APFS pure clone"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已验证的 APFS 纯克隆"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已驗證的 APFS 純複製檔"}}}},
  "files.batch_limit":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Select at most 100,000 entries per operation. Nothing was changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"每次操作最多选择 100,000 项。未更改任何文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"每次操作最多選取 100,000 個項目。未更改任何檔案。"}}}},
  "files.busy":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Too many pending file operations, or the request identifier is already in use."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"待处理的文件操作过多，或请求标识已在使用中。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"待處理的檔案操作過多，或要求識別碼已在使用中。"}}}},
  "files.cancelling_batch":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Stopping after the current file…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将在当前文件完成后停止…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"將在目前檔案完成後停止…"}}}},
  "files.completed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Completed"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成"}}}},
  "files.destination":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Destination / new name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目标／新名称"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目的地／新名稱"}}}},
  "files.history_page_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Showing the latest %@ of %@ operations. Unfinished intents require review; they are not automatically retried."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示最近 %@ 项，共 %@ 项。未完成的操作计划需要检查，不会自动重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"顯示最近 %@ 個操作，共 %@ 個。未完成的操作計畫需要檢查，不會自動重試。"}}}},
  "files.include":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Include"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"执行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"執行"}}}},
  "files.invalid_conflict_policy":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unsupported conflict policy. Existing files are never overwritten."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"不支持此冲突策略。不会覆盖已有文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"不支援此衝突策略。不會覆寫現有檔案。"}}}},
  "files.invalid_journal":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The operation journal is invalid or is not a regular file. No operation was started."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"操作日志无效或不是普通文件。未开始执行操作。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"操作記錄無效或不是一般檔案。尚未開始執行操作。"}}}},
  "files.item_status":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Result / conflict"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"结果／冲突"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"結果／衝突"}}}},
  "files.needs_review":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Needs review"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"需要检查"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"需要檢查"}}}},
  "files.next_page":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Next page"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下一页"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下一頁"}}}},
  "files.not_started":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Not started"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未开始"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尚未開始"}}}},
  "files.overlapping_sources":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"A selected folder and one of its descendants overlap. Review or split the selection."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选文件夹与其后代项目重叠。请检查或分开操作。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所選資料夾與其後代項目重疊。請檢查或分開操作。"}}}},
  "files.page_summary":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ items · page %@/%@ · %@ selected"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 项 · 第 %@/%@ 页 · 已选 %@ 项"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"%@ 個項目 · 第 %@/%@ 頁 · 已選 %@ 個"}}}},
  "files.performing_batch":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Applying file operations (stop after current item)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在执行文件操作（停止将在当前项完成后生效）"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在執行檔案操作（停止將在目前項目完成後生效）"}}}},
  "files.preview_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Uncheck items to skip them. Edit a destination leaf name to resolve a conflict; Continue rechecks edited names before a second confirmation. Existing files will not be overwritten."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"取消勾选可跳过项目。编辑目标文件名可处理冲突；继续后会重新检查，并再次确认。不会覆盖已有文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取消勾選可略過項目。編輯目標檔名可處理衝突；繼續後會重新檢查，並再次確認。不會覆寫現有檔案。"}}}},
  "files.previous_page":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Previous page"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"上一页"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"上一頁"}}}},
  "files.protected_root":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The filesystem root cannot be changed by a bulk operation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"批量操作不能更改文件系统根目录。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"批次操作不能更改檔案系統根目錄。"}}}},
  "files.ready":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Ready"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"可执行"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"可執行"}}}},
  "files.rename_count":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Rename %@ files"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重命名 %@ 个文件"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重新命名 %@ 個檔案"}}}},
  "files.rename_find":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Find in name"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查找名称中的文字"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"尋找名稱中的文字"}}}},
  "files.rename_numbering":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Append sequence number"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"追加序号"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"附加序號"}}}},
  "files.rename_prefix":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Prefix"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"前缀"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"前綴"}}}},
  "files.rename_replace":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Replace with"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"替换为"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"取代為"}}}},
  "files.rename_suffix":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Suffix"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"后缀"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"後綴"}}}},
  "files.repeated_source":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selection contains the same source more than once."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"所选项目重复包含同一个源文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"所選項目重複包含同一個來源檔案。"}}}},
  "files.results_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Completed changes are recorded for undo. Failed or interrupted items need review; partial copies are never deleted or retried automatically."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已完成的更改有撤销记录。失败或中断的项目需要检查；不会自动删除部分副本或重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已完成的更改有還原記錄。失敗或中斷的項目需要檢查；不會自動刪除部分副本或重試。"}}}},
  "files.selection_expired":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selection snapshot expired. Run the search again; no partial operation was performed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择快照已过期。请重新搜索；未执行部分操作。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選取快照已到期。請重新搜尋；未執行部分操作。"}}}},
  "files.selection_incomplete":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The service did not return the complete selected page on the expected snapshot. Nothing was changed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"服务未返回预期快照中完整的所选页面。未更改任何文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"服務未傳回預期快照中完整的所選頁面。未更改任何檔案。"}}}},
  "files.skipped":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Skipped"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已跳过"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已略過"}}}},
  "files.source":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Source"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"来源"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"來源"}}}},
  "files.source_changed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The source identity or metadata changed after selection. Review the files and retry."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择后源文件的身份或元数据发生变化。请检查文件后重试。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"選取後來源檔案的身分或中繼資料已變更。請檢查檔案後重試。"}}}},
  "files.survivor_changed":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The duplicate group no longer has its verified retained file. No further cleanup was performed."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重复组中要保留的文件已无法验证。已停止后续清理。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"重複群組中要保留的檔案已無法驗證。已停止後續清理。"}}}},
  "files.unchanged":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Unchanged"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未改变"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"未變更"}}}},
  "files.undo_needs_review":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"A previous undo was interrupted. Review its source and destination before further changes."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"之前的撤销操作已中断。请先检查源文件和目标文件。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"先前的還原操作已中斷。請先檢查來源檔案及目標檔案。"}}}},
  "files.unsupported_type":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only regular files, directories and symbolic links are supported."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅支持普通文件、目录和符号链接。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"僅支援一般檔案、目錄及符號連結。"}}}},
  "update.automatic":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check for Updates Automatically"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"自动检查更新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"自動檢查更新"}}}},
  "update.available":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"APFSearch %@ is available"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"APFSearch %@ 已可更新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"APFSearch %@ 已可更新"}}}},
  "update.check":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check for Updates…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"检查更新…"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"檢查更新…"}}}},
  "update.digest_mismatch":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The downloaded installer does not match the signed size or SHA-256 digest."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载的安装包大小或 SHA-256 摘要与签名内容不一致。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載的安裝套件大小或 SHA-256 摘要與簽章內容不符。"}}}},
  "update.disabled":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Updates are not configured in this build. A trusted public key and HTTPS feed must be embedded before signing a release."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此构建尚未配置更新。正式签名前需嵌入可信公钥和 HTTPS 更新源。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"此建置尚未設定更新。正式簽章前需嵌入可信公鑰及 HTTPS 更新來源。"}}}},
  "update.download":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Download Verified Installer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载并验证安装包"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載並驗證安裝套件"}}}},
  "update.download_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Download %@? The manifest signature, byte limit and SHA-256 digest are checked before opening Installer."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"下载 %@？打开安装器前将检查清单签名、大小限制和 SHA-256 摘要。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"下載 %@？開啟安裝程式前將檢查清單簽章、大小限制及 SHA-256 摘要。"}}}},
  "update.downloading":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Downloading update"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在下载更新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在下載更新"}}}},
  "update.install_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The signed download has been verified. Installer will still enforce macOS trust checks. Close APFSearch and restart its background service after installation."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已验证签名下载。安装器仍会执行 macOS 信任检查。安装后请关闭 APFSearch 并重新启动其后台服务。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"已驗證簽章下載。安裝程式仍會執行 macOS 信任檢查。安裝後請關閉 APFSearch 並重新啟動其背景服務。"}}}},
  "update.invalid_manifest":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The update manifest is invalid or exceeds the supported limits."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新清单无效或超过支持的限制。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"更新清單無效或超過支援的限制。"}}}},
  "update.invalid_signature":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The update signature could not be verified."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法验证更新签名。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法驗證更新簽章。"}}}},
  "update.invalid_url":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Updates require an HTTPS URL without embedded credentials."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新必须使用不包含凭据的 HTTPS 地址。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"更新必須使用不含憑證資訊的 HTTPS 網址。"}}}},
  "update.open_installer":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Installer"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"打开安装器"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"開啟安裝程式"}}}},
  "update.ready":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Update verified"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"更新已验证"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"更新已驗證"}}}},
  "update.title":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"APFSearch Updates"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"APFSearch 更新"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"APFSearch 更新"}}}},
  "update.too_large":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The response exceeds the signed or configured byte limit. The transfer was stopped."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"响应超过签名或配置的大小限制。已停止传输。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"回應超過簽章或設定的大小限制。已停止傳輸。"}}}},
  "update.transport_error":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"The update could not be transferred or opened."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法传输或打开更新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"無法傳輸或開啟更新。"}}}},
  "update.up_to_date":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"This version is up to date."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"当前版本已是最新。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"目前版本已是最新。"}}}},
  "update.verification_notice":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Downloading with a fixed byte budget and verifying the signed digest. Cancel removes incomplete data."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在按固定大小上限下载并验证签名摘要。取消将移除未完成的数据。"}},"zh-Hant":{"stringUnit":{"state":"translated","value":"正在依固定大小上限下載並驗證簽章摘要。取消將移除未完成的資料。"}}}}
}}
