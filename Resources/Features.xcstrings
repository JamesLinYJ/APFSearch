    "duplicates.keep_one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at least one verified file in every group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每组至少保留一个已验证的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每組至少保留一個已驗證的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループに、検証済みのファイルを少なくとも1つ残してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 그룹에 검증된 파일을 하나 이상 남겨 두십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте хотя бы один проверенный файл в каждой группе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva al menos un archivo verificado en cada grupo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha pelo menos um ficheiro verificado em cada grupo."
          }
        }
      }
    },
