    "files.undo_needs_review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous undo was interrupted. Review its source and destination before further changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的撤销操作已中断。请先检查源文件和目标文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的還原操作已中斷。請先檢查來源檔案及目標檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の取り消しが中断されました。さらに変更する前に、操作元と移動先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 실행 취소가 중단되었습니다. 추가 변경 전에 원본과 대상을 검토하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая отмена была прервана. Перед дальнейшими изменениями проверьте её источник и назначение."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió una acción de deshacer anterior. Revisa su origen y destino antes de hacer más cambios."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma ação de desfazer anterior foi interrompida. Reveja a origem e o destino antes de fazer mais alterações."
          }
        }
      }
    },
