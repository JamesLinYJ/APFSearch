    "update.install_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed download has been verified. Installer will still enforce macOS trust checks. Close APFSearch and restart its background service after installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证签名下载。安装器仍会执行 macOS 信任检查。安装后请关闭 APFSearch 并重新启动其后台服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已驗證簽章下載。安裝程式仍會執行 macOS 信任檢查。安裝後請關閉 APFSearch 並重新啟動其背景服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名付きダウンロードの検証が完了しました。インストーラでもmacOSの信頼性チェックが行われます。インストール後はAPFSearchを閉じ、バックグラウンドサービスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 다운로드의 검증이 완료되었습니다. 설치 프로그램에서도 macOS 신뢰 검사를 수행합니다. 설치 후 APFSearch를 닫고 백그라운드 서비스를 재시작하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписанная загрузка проверена. Установщик также выполнит проверки доверия macOS. После установки закройте APFSearch и перезапустите фоновую службу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga firmada se ha verificado. El instalador seguirá aplicando las comprobaciones de confianza de macOS. Cierra APFSearch y reinicia su servicio en segundo plano después de instalar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência assinada foi verificada. O Instalador continuará a aplicar as verificações de confiança do macOS. Feche o APFSearch e reinicie o serviço em segundo plano após a instalação."
          }
        }
      }
    },
