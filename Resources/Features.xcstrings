    "files.protected_root": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filesystem root cannot be changed by a bulk operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量操作不能更改文件系统根目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次操作不能更改檔案系統根目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一括操作ではファイルシステムのルートを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
