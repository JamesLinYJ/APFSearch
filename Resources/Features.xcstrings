          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корень файловой системы нельзя изменять массовой операцией."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar la raíz del sistema de archivos mediante una operación por lotes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A raiz do sistema de ficheiros não pode ser alterada por uma operação em lote."
          }
        }
      }
