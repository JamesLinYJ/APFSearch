    "update.verification_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading with a fixed byte budget and verifying the signed digest. Cancel removes incomplete data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在按固定大小上限下载并验证签名摘要。取消将移除未完成的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在依固定大小上限下載並驗證簽章摘要。取消將移除未完成的資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定のバイト上限でダウンロードし、署名済みダイジェストを検証します。キャンセルすると未完了のデータは削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정해진 바이트 한도 내에서 다운로드하고 서명된 다이제스트를 검증합니다. 취소하면 미완료 데이터가 삭제됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка с фиксированным лимитом байтов и проверкой подписанного хеша. При отмене неполные данные удаляются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando con un límite fijo de bytes y verificando el resumen firmado. Cancelar elimina los datos incompletos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A descarregar com um limite fixo de bytes e a verificar o resumo assinado. Cancelar remove os dados incompletos."
          }
        }
      }
    }
