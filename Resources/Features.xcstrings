    "files.repeated_source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection contains the same source more than once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选项目重复包含同一个源文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選項目重複包含同一個來源檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ操作元が複数回選択されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택에 동일한 원본이 두 번 이상 포함되어 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выборке один источник указан несколько раз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección contiene el mismo origen más de una vez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção contém a mesma origem mais de uma vez."
          }
        }
      }
    },
    "files.results_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed changes are recorded for undo. Failed or interrupted items need review; partial copies are never deleted or retried automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的更改有撤销记录。失败或中断的项目需要检查；不会自动删除部分副本或重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的更改有還原記錄。失敗或中斷的項目需要檢查；不會自動刪除部分副本或重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した変更は取り消し用に記録されます。失敗または中断した項目は確認が必要です。不完全なコピーを自動で削除したり、再試行したりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 변경은 실행 취소를 위해 기록됩니다. 실패하거나 중단된 항목은 검토가 필요하며, 불완전한 사본은 자동으로 삭제하거나 다시 시도하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённые изменения записаны для отмены. Ошибки и прерванные операции требуют проверки; неполные копии никогда не удаляются и не повторяются автоматически."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios completados se registran para poder deshacerlos. Los elementos fallidos o interrumpidos requieren revisión; las copias parciales nunca se eliminan ni se reintentan automáticamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações concluídas são registadas para poderem ser desfeitas. Os itens com falhas ou interrompidos requerem revisão; as cópias parciais nunca são eliminadas ou repetidas automaticamente."
          }
        }
      }
    },
    "files.selection_expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection snapshot expired. Run the search again; no partial operation was performed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择快照已过期。请重新搜索；未执行部分操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取快照已到期。請重新搜尋；未執行部分操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択内容のスナップショットが期限切れです。再検索してください。操作の一部だけを実行することはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 스냅샷이 만료되었습니다. 다시 검색하십시오. 일부 항목에만 작업을 수행하지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок снимка выборки истёк. Выполните поиск заново; частичная операция не выполнялась."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea de la selección caducó. Repite la búsqueda; no se realizó ninguna operación parcial."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O instantâneo da seleção expirou. Repita a pesquisa; não foi efetuada nenhuma operação parcial."
          }
        }
      }
    },
    "files.selection_incomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service did not return the complete selected page on the expected snapshot. Nothing was changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务未返回预期快照中完整的所选页面。未更改任何文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務未傳回預期快照中完整的所選頁面。未更改任何檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "想定したスナップショットの選択ページ全体がサービスから返されませんでした。変更は行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스가 예상된 스냅샷에서 선택한 페이지 전체를 반환하지 않았습니다. 변경된 내용은 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба не вернула полную выбранную страницу ожидаемого снимка. Ничего не изменено."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio no devolvió la página seleccionada completa de la instantánea esperada. No se ha cambiado nada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço não devolveu a página selecionada completa do instantâneo esperado. Nada foi alterado."
          }
        }
      }
    },
