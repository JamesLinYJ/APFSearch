    "files.overlapping_sources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A selected folder and one of its descendants overlap. Review or split the selection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件夹与其后代项目重叠。请检查或分开操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選資料夾與其後代項目重疊。請檢查或分開操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したフォルダとその配下の項目が重複しています。選択内容を確認するか、分けて操作してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 폴더와 그 하위 항목이 겹칩니다. 선택을 검토하거나 나누십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная папка пересекается с одним из её потомков. Проверьте или разделите выборку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta seleccionada se solapa con uno de sus elementos descendientes. Revisa o divide la selección."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta selecionada sobrepõe-se a um dos seus descendentes. Reveja ou divida a seleção."
          }
        }
      }
    },
