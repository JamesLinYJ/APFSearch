        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발견된 파일부터 표시됩니다. 스캔이 끝나기 전에도 검색을 시작할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы появляются по мере обнаружения. Поиск можно начать до завершения сканирования."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos aparecen a medida que se descubren. Puedes empezar a buscar antes de que termine el escaneo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros aparecem à medida que são encontrados. Pode começar a pesquisar antes de a análise terminar."
          }
        }
      }
    },
