    "settings.background_service_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "索引服务持续监听文件变化。关闭搜索窗口后仍可更新索引；可在系统设置中管理后台运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The index service monitors file changes and can keep updating after search windows are closed. Manage background activity in System Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "索引服務持續監聽檔案變化。關閉搜尋視窗後仍可更新索引；可在系統設定中管理背景運行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックスサービスはファイルの変更を監視し、検索ウインドウを閉じた後も更新を続けられます。バックグラウンド動作はシステム設定で管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색인 서비스는 파일 변경을 감시하며 검색 윈도우를 닫은 후에도 업데이트를 계속할 수 있습니다. 시스템 설정에서 백그라운드 활동을 관리하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба индексации отслеживает изменения файлов и может обновлять индекс после закрытия окон поиска. Фоновая активность управляется в Системных настройках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de indexación supervisa los cambios de archivos y puede seguir actualizando tras cerrar las ventanas de búsqueda. Gestiona la actividad en segundo plano en Ajustes del Sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de indexação monitoriza alterações nos ficheiros e pode continuar a atualizar depois de fechar as janelas de pesquisa. Gira a atividade em segundo plano nas Definições do Sistema."
          }
        }
      }
    },
    "settings.bookmark_example": {
      "extractionState": "manual",
      "localizations": {
