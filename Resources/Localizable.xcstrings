    },
    "duplicates.scope_notice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测范围为本次索引中的文件。检测过程中新增的文件将在下次核对。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This check covers files in the current index. Files added during the check are included next time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測範圍為本次索引中的檔案。偵測過程中新增的檔案將在下次核對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のインデックス内のファイルを確認します。確認中に追加されたファイルは次回の対象になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 색인의 파일을 확인합니다. 확인 중 추가된 파일은 다음 검사에 포함됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяются файлы текущего индекса. Добавленные во время проверки файлы будут включены в следующий раз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comprobación abarca los archivos del índice actual. Los añadidos durante la comprobación se incluirán la próxima vez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificação abrange os ficheiros do índice atual. Os ficheiros adicionados durante a verificação serão incluídos da próxima vez."
          }
        }
      }
    },
    "duplicates.storage_notice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同内容不代表可以删除。APFS 克隆的共享存储关系未知。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching contents do not mean a file is safe to delete. APFS clone storage sharing is unknown."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同內容不代表可以刪除。APFS 複製的共享儲存關係未知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が一致しても安全に削除できるとは限りません。APFSクローンによるストレージ共有の有無は不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 같아도 안전하게 삭제할 수 있다는 뜻은 아닙니다. APFS 클론의 저장 공간 공유 여부는 알 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадение содержимого не гарантирует безопасного удаления. Совместное использование хранилища клонами APFS неизвестно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La coincidencia de contenido no garantiza que sea seguro eliminar un archivo. Se desconoce si los clones APFS comparten almacenamiento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdos iguais não garantem que seja seguro eliminar um ficheiro. A partilha de armazenamento por clones APFS é desconhecida."
          }
        }
      }
    },
