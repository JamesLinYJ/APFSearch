          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키와 로그인 변경 사항은 즉시 적용됩니다. 단축키가 이미 사용 중이면 다른 조합을 선택하십시오."
          }
        },
        "ru": {
