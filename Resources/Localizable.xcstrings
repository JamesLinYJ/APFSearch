    "settings.exclusions_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条查询，例如 path:\"/Users/你的用户名/Library/Caches\"。匹配的结果会被排除；不会删除磁盘上的文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One query per line, such as path:\"/Users/yourname/Library/Caches\". Matching results are excluded; files on disk are not deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一條查詢，例如 path:\"/Users/你的用戶名/Library/Caches\"。匹配的結果會被排除；不會刪除磁碟上的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1つのクエリを入力します。例: path:\"/Users/yourname/Library/Caches\"。一致する結果を除外しますが、ディスク上のファイルは削除しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 검색식을 하나씩 입력하십시오. 예: path:\"/Users/yourname/Library/Caches\". 일치하는 결과는 제외되지만 디스크의 파일은 삭제되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному запросу на строку, например path:\"/Users/yourname/Library/Caches\". Совпадения исключаются из результатов; файлы на диске не удаляются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una consulta por línea, como path:\"/Users/yourname/Library/Caches\". Los resultados coincidentes se excluyen; los archivos del disco no se eliminan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma consulta por linha, como path:\"/Users/yourname/Library/Caches\". Os resultados correspondentes são excluídos; os ficheiros no disco não são eliminados."
          }
        }
      }
    },
