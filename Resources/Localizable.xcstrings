    "settings.bookmarks_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个：书签名称 = 查询。也可以在搜索窗口按 ⌘D 保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line: bookmark name = query. You can also press ⌘D in the search window."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個：書簽名稱 = 查詢。也可以在搜尋視窗按 ⌘D 儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行につき「ブックマーク名 = クエリ」を入力します。検索ウインドウで⌘Dを押すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩 '책갈피 이름 = 검색식'을 입력하십시오. 검색 윈도우에서 ⌘D를 눌러도 됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной строке: имя закладки = запрос. Также можно нажать ⌘D в окне поиска."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno por línea: nombre del marcador = consulta. También puedes pulsar ⌘D en la ventana de búsqueda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um por linha: nome do marcador = consulta. Também pode premir ⌘D na janela de pesquisa."
          }
        }
      }
    },
    "settings.bookmarks_history_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书签和历史可从搜索框右侧菜单直接调用。修改后点击“保存搜索设置”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access bookmarks and history from the menu beside the search field. After editing, choose Save Search Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "書簽和歷史可從搜尋框右側菜單直接調用。修改後按一下“儲存搜尋設定”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索欄の横のメニューからブックマークや履歴にアクセスできます。編集後は「検索設定を保存」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 필드 옆 메뉴에서 책갈피와 기록을 열 수 있습니다. 편집 후 '검색 설정 저장'을 선택하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закладки и история доступны в меню рядом с полем поиска. После редактирования выберите «Сохранить настройки поиска»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accede a marcadores e historial desde el menú junto al campo de búsqueda. Tras editar, elige Guardar ajustes de búsqueda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceda aos marcadores e ao histórico no menu junto ao campo de pesquisa. Após editar, escolha Guardar definições de pesquisa."
          }
        }
      }
    },
    "settings.enable_background_service_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 通用 → 登录项中允许 APFSearch 后台服务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the APFSearch background service in System Settings → General → Login Items."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定 → 一般 → 登入項目中允許 APFSearch 背景服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → 一般 → ログイン項目でAPFSearchのバックグラウンドサービスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목에서 APFSearch 백그라운드 서비스를 허용하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите фоновую службу APFSearch: Системные настройки → Основные → Объекты входа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el servicio en segundo plano de APFSearch en Ajustes del Sistema → General → Ítems de inicio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o serviço em segundo plano do APFSearch em Definições do Sistema → Geral → Itens de início de sessão."
          }
        }
      }
    },
