            "state": "translated",
            "value": "发现的文件会陆续显示，无需等待整个扫描结束。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files appear as they are discovered. You can start searching before the scan finishes."
