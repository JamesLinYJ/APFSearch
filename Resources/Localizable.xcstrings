    "setup.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access lets APFSearch index file names in protected folders. Your index stays on this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启完整磁盘访问后，APFSearch 可以索引受保护文件夹中的文件名。索引保存在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟完整磁碟存取權後，APFSearch 可以索引受保護資料夾中的檔案名稱。索引保存在這台 Mac 上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスを許可すると、保護されたフォルダのファイル名も索引に追加できます。索引はこの Mac に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근을 허용하면 보호된 폴더의 파일 이름도 색인할 수 있습니다. 색인은 이 Mac에 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный доступ к диску позволяет индексировать имена файлов в защищённых папках. Индекс хранится на этом Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso total al disco permite indexar nombres de archivos en carpetas protegidas. El índice se guarda en este Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso total ao disco permite indexar nomes de arquivos em pastas protegidas. O índice fica neste Mac."
          }
        }
      }
    },
    "setup.step_one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Full Disk Access in System Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开系统设置中的“完全磁盘访问权限”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟系統設定中的「完整磁碟存取權」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で「フルディスクアクセス」を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 전체 디스크 접근 권한을 여세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Полный доступ к диску» в Системных настройках."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Acceso total al disco en Ajustes del Sistema."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Acesso Total ao Disco nos Ajustes do Sistema."
          }
        }
      }
    },
    "setup.step_two": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag APFSearch.app below into the settings list, then turn its switch on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将下方的 APFSearch.app 拖入权限列表，然后开启旁边的开关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將下方的 APFSearch.app 拖入權限清單，然後開啟旁邊的開關。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の APFSearch.app を設定のリストにドラッグし、スイッチをオンにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 APFSearch.app을 설정 목록으로 드래그한 다음 스위치를 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите APFSearch.app ниже в список настроек и включите переключатель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra APFSearch.app desde abajo hasta la lista de ajustes y activa su interruptor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o APFSearch.app abaixo para a lista dos ajustes e ative a opção."
          }
        }
      }
    },
    "setup.step_three": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return here to choose what to index. If macOS asks you to quit and reopen, follow its prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回这里选择索引范围。如果 macOS 提示退出并重新打开，请按系统提示操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回這裡選擇索引範圍。如果 macOS 提示結束並重新開啟，請依系統提示操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻って索引の範囲を選びます。macOS から再起動を求められた場合は、その案内に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 돌아와 색인 범위를 선택하세요. macOS가 종료 후 다시 열기를 요청하면 안내를 따르세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернитесь сюда и выберите область индексации. Если macOS предложит перезапустить приложение, следуйте указаниям."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve aquí para elegir qué indexar. Si macOS te pide cerrar y volver a abrir la app, sigue sus indicaciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte aqui para escolher o que indexar. Se o macOS pedir para encerrar e reabrir o app, siga as instruções."
          }
        }
      }
    },
    "setup.optional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. You can continue with accessible folders and change permissions later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限可稍后设置。你仍可搜索已允许访问的文件夹，也可以随时在设置中调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "權限可稍後設定。你仍可搜尋已允許存取的資料夾，也可以隨時在設定中調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可は任意です。アクセス可能なフォルダで続け、後から設定を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한은 선택 사항입니다. 접근 가능한 폴더로 계속하고 나중에 설정을 변경할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение необязательно. Можно продолжить с доступными папками и изменить настройки позже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es opcional. Puedes continuar con las carpetas accesibles y cambiar los permisos más adelante."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É opcional. Você pode continuar com as pastas acessíveis e alterar as permissões depois."
          }
        }
      }
    },
