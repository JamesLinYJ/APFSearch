    "index.initial_scan_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次扫描后即可按文件名搜索。扫描包括隐藏文件与应用包内部；不可访问的位置会在覆盖情况中列出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search by filename after the initial scan. Hidden files and app bundle contents are included; inaccessible locations appear in the coverage report."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次掃描後即可按檔案名搜尋。掃描包括隱藏檔案與應用包內部；不可訪問的位置會在覆蓋情況中列出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回スキャン後はファイル名で検索できます。隠しファイルやアプリの内部も対象です。アクセスできない場所は網羅状況レポートに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 스캔 후 파일 이름으로 검색할 수 있습니다. 숨김 파일과 앱 번들 내부도 포함되며, 접근할 수 없는 위치는 포함 현황 보고서에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После первого сканирования доступен поиск по именам. Учитываются скрытые файлы и содержимое пакетов приложений; недоступные расположения указаны в отчёте о полноте индекса."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por nombre tras el escaneo inicial. Se incluyen archivos ocultos y contenido de paquetes de apps; las ubicaciones inaccesibles aparecen en el informe de cobertura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise por nome após a análise inicial. São incluídos ficheiros ocultos e o conteúdo dos pacotes de aplicações; as localizações inacessíveis aparecem no relatório de cobertura."
          }
        }
      }
    },
