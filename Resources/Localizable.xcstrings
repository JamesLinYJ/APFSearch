    "index.coverage_limitations": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未挂载、未解锁及无权限的内容不会显示为完整覆盖。云端占位文件不会自动下载；快照和离线列表不计入当前本机文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmounted, locked, and inaccessible content is not counted as fully covered. Cloud placeholders are not downloaded automatically. Snapshots and offline lists are separate from current local files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未掛載、未解鎖及無權限的內容不會顯示為完整覆蓋。雲端佔位檔案不會自動下載；快照和離線列表不計入當前本機檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未マウント、ロック中、アクセス不可の内容は完全に網羅されたとはみなしません。クラウドのプレースホルダは自動でダウンロードされません。スナップショットとオフラインリストは現在のローカルファイルとは別に扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마운트되지 않았거나 잠겨 있거나 접근할 수 없는 콘텐츠는 완전히 포함된 것으로 간주하지 않습니다. 클라우드 자리 표시자 파일은 자동으로 다운로드되지 않습니다. 스냅샷과 오프라인 목록은 현재 로컬 파일과 별도로 처리됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключённое, заблокированное и недоступное содержимое не считается полностью охваченным. Облачные файлы-заполнители не загружаются автоматически. Снимки и автономные списки отделены от текущих локальных файлов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido sin montar, bloqueado o inaccesible no se considera totalmente cubierto. Los archivos de marcador de posición en la nube no se descargan automáticamente. Las instantáneas y las listas sin conexión se mantienen separadas de los archivos locales actuales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo não montado, bloqueado ou inacessível não é considerado totalmente abrangido. Os ficheiros de marcador de posição na nuvem não são descarregados automaticamente. Os instantâneos e as listas offline são separados dos ficheiros locais atuais."
          }
        }
      }
    },
