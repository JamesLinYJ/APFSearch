    "app.about_description": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\n搜索这台 Mac 上的文件与文件夹。\n独立实现；与 voidtools 无关联。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nSearch files and folders on this Mac.\nIndependent implementation; not affiliated with voidtools."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\n搜尋這台 Mac 上的檔案與資料夾。\n獨立實現；與 voidtools 無關聯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nこのMacのファイルやフォルダを検索します。\n独立した実装であり、voidtoolsとは関係ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\n이 Mac의 파일과 폴더를 검색합니다.\n독립적으로 구현되었으며 voidtools와 관련이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nПоиск файлов и папок на этом Mac.\nНезависимая реализация, не связанная с voidtools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nBusca archivos y carpetas en este Mac.\nImplementación independiente, sin afiliación con voidtools."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nPesquise ficheiros e pastas neste Mac.\nImplementação independente, sem ligação à voidtools."
          }
        }
      }
    },
