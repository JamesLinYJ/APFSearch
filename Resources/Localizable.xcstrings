          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前沒有報告未覆蓋的目錄。掃描過程中覆蓋情況仍可能變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、未網羅のフォルダは報告されていません。スキャンの進行に伴い、網羅状況が変わる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 포함되지 않은 폴더가 보고되지 않았습니다. 스캔이 진행되면서 포함 현황이 달라질 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не сообщается о неохваченных папках. Полнота индекса может меняться по мере сканирования."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no se han notificado carpetas sin cubrir. La cobertura puede cambiar mientras continúa el escaneo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente não há pastas não abrangidas no relatório. A cobertura pode mudar à medida que a análise continua."
          }
        }
      }
    },
    "index.no_uncovered_yet_notice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有报告未覆盖位置。扫描尚未完成时，这不表示全盘已覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No uncovered locations have been reported. While scanning is in progress, this does not mean the entire disk is covered."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前沒有報告未覆蓋位置。掃描尚未完成時，這不表示全盤已覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未網羅の場所はまだ報告されていません。スキャン中は、ディスク全体の網羅を意味しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 포함되지 않은 위치가 보고되지 않았습니다. 스캔 중에는 디스크 전체가 포함되었다는 의미가 아닙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О неохваченных расположениях пока не сообщалось. Во время сканирования это не означает, что охвачен весь диск."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se han notificado ubicaciones sin cubrir. Mientras el escaneo está en curso, esto no significa que se haya cubierto todo el disco."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não foram indicadas localizações não abrangidas. Durante a análise, isto não significa que todo o disco esteja abrangido."
          }
        }
      }
    },
