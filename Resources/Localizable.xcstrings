    "duplicates.identity_notice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n相同内容不代表可以删除。硬链接可能指向同一文件，APFS 克隆可能共享存储空间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIdentical contents do not mean files can be deleted. Hard links may reference the same file, and APFS clones may share storage."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n相同內容不代表可以刪除。硬鏈接可能指向同一檔案，APFS 克隆可能共享儲存空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n内容が同一でも削除できるとは限りません。ハードリンクは同じファイルを参照し、APFSクローンはストレージを共有している場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n내용이 같다고 해서 삭제해도 되는 것은 아닙니다. 하드 링크는 같은 파일을 가리킬 수 있으며 APFS 클론은 저장 공간을 공유할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nСовпадение содержимого не означает, что файлы можно удалить. Жёсткие ссылки могут указывать на один файл, а клоны APFS — совместно использовать хранилище."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nUn contenido idéntico no implica que los archivos puedan eliminarse. Los enlaces físicos pueden apuntar al mismo archivo y los clones APFS pueden compartir almacenamiento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nConteúdos idênticos não significam que os ficheiros possam ser eliminados. As ligações físicas podem apontar para o mesmo ficheiro e os clones APFS podem partilhar armazenamento."
          }
        }
      }
    },
    "duplicates.independent_files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
