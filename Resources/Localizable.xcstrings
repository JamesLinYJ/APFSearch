    "cli.usage": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — 文件搜索\n用法：apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\n使用应用的搜索服务。首次使用请打开 APFSearch.app。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nUsage: apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\nUses the app’s search service. Open APFSearch.app before first use."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — 檔案搜尋\n用法：apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\n使用應用程式的搜尋服務。首次使用請開啟 APFSearch.app。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\n使い方: apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\nアプリの検索サービスを使用します。初回使用前にAPFSearch.appを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\n사용법: apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\n앱의 검색 서비스를 사용합니다. 처음 사용하기 전에 APFSearch.app을 여십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nИспользование: apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\nИспользует службу поиска приложения. Перед первым использованием откройте APFSearch.app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nUso: apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\nUsa el servicio de búsqueda de la app. Abre APFSearch.app antes del primer uso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSearch — All-Purpose File Search\nUtilização: apfsearch-cli status | volumes | search <query> | scan <roots...> | --json '<request>'\nUtiliza o serviço de pesquisa da aplicação. Abra APFSearch.app antes da primeira utilização."
          }
        }
      }
    },
