    "duplicates.identity_notice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n相同内容不代表可以删除。硬链接可能指向同一文件，APFS 克隆可能共享存储空间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nIdentical contents do not mean files can be deleted. Hard links may reference the same file, and APFS clones may share storage."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n相同內容不代表可以刪除。硬鏈接可能指向同一檔案，APFS 克隆可能共享儲存空間。"
          }
        }
      }
